# kicad/LVGL/jlcpcb/production_files/ is generated by the fabrication toolkit,
# but the README tells people to order the board from it - so it is committed.
# It was previously ignored, which left five dead links in the build
# instructions and no way for anyone else to get the boards made.
kicad/LVGL/jlcpcb/gerber/
kicad/LVGL/jlcpcb/project.db

kicad/LVGL/TeensyELS-backups/

# KiCad writes ~<file>.lck beside a board or schematic while an editor has
# it open, and removes it on close - per-session state, never content. Two
# were committed by accident and lingered for months; this keeps them out
# for every project here, which makes the two kicad/4Layer/ lines above
# redundant rather than wrong.
~*.lck

# Python bytecode from scripts/ (make_logo.py imports make_glyphs.py)
__pycache__/
*.pyc

# Cygwin/MSYS crash dumps from the Bash tool (heredoc failures on large content)
bash.exe.stackdump
*.stackdump
